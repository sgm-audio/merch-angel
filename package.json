{
  "name": "@scottmills306/merch-angel",
  "version": "0.1.0",
  "description": "Image → Shopify-ready SVG batch pipeline. Brand-grade vectors without the bloat.",
  "bin": {
    "merch-angel": "./bin/merch-angel.js"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "postinstall": "bash ./scripts/install-vtracer.sh 2>/dev/null || true",
    "dev": "bun run src/cli.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --apply src/",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "doctor": "bun run src/cli.ts doctor",
    "clean": "rm -rf output/ node_modules/"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "vtracer.shasums",
    "bin/"
  ],
  "keywords": [
    "svg",
    "vector",
    "vtracer",
    "shopify",
    "printful",
    "printify",
    "merch",
    "batch-convert",
    "image-trace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottmills306/merch-angel.git"
  },
  "homepage": "https://github.com/scottmills306/merch-angel#readme",
  "bugs": {
    "url": "https://github.com/scottmills306/merch-angel/issues"
  },
  "author": "SGM Studios <scottmills306@gmail.com>",
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.3.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "imagetracerjs": "^1.2.6"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --apply"
    ]
  },
  "vtracerVersion": "0.6.4"
}
